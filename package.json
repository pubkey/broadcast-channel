{
  "name": "@toruslabs/broadcast-channel",
  "version": "13.3.0",
  "description": "A BroadcastChannel that works in New Browsers, Old Browsers, WebWorkers",
  "homepage": "https://github.com/torusresearch/broadcast-channel#readme",
  "keywords": [
    "broadcast-channel",
    "broadcastchannel",
    "broadcast",
    "polyfill",
    "localstorage",
    "indexeddb",
    "postMessage",
    "crosstab"
  ],
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/torusresearch/broadcast-channel.git"
  },
  "author": "pubkey",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/torusresearch/broadcast-channel/issues"
  },
  "main": "dist/lib.cjs/index.js",
  "module": "dist/lib.esm/index.js",
  "sideEffects": false,
  "types": "dist/lib.cjs/index.d.ts",
  "jsdelivr": "dist/lib.esm/index.js",
  "unpkg": "dist/lib.esm/index.js",
  "scripts": {
    "build": "vp pack",
    "prepack": "npm run build",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node && npm run test:browser",
    "test:node": "vp test run --config test/configs/node.config.mts --coverage",
    "test:node:loop": "npm run test:node && npm run test:node:loop",
    "test:browser": "vp test run --config test/configs/browsers.config.mts --coverage",
    "test:typings": "npm run build && vp test run --config test/configs/typing.config.mts",
    "test:performance": "vp test run --config test/configs/performance.config.mts",
    "test:simple": "vp test run --config test/configs/simple.config.mts",
    "test:e2e": "npm run build && npm run build:docs && concurrently \"npm run docs:only\" \"sleep 5 && testcafe chrome:headless -e test/e2e.test.js --hostname localhost\" --kill-others --success first",
    "build:docs": "concurrently \"npm run build:docs:index\" \"npm run build:docs:e2e\" \"npm run build:docs:worker\" \"npm run build:docs:iframe\"",
    "build:docs:index": "esbuild test/scripts/index.js --bundle --outfile=docs/index.js --format=iife",
    "build:docs:e2e": "esbuild test/scripts/e2e.js --bundle --outfile=docs/e2e.js --format=iife",
    "build:docs:worker": "esbuild test/scripts/worker.js --bundle --outfile=docs/worker.js --format=iife",
    "build:docs:iframe": "esbuild test/scripts/iframe.js --bundle --outfile=docs/iframe.js --format=iife",
    "docs:only": "http-server ./docs --silent",
    "docs:serve": "npm run build && npm run build:docs && echo \"Open http://localhost:8080/\" && npm run docs:only",
    "prepare": "husky",
    "changeset": "changeset",
    "version-packages": "changeset version && npm install --package-lock-only --ignore-scripts",
    "release-packages": "changeset publish"
  },
  "dependencies": {
    "@toruslabs/constants": "^17.0.0",
    "@toruslabs/eccrypto": "^8.0.0",
    "@toruslabs/metadata-helpers": "^9.0.0",
    "loglevel": "^1.9.2",
    "oblivious-set": "2.0.0",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@lavamoat/harden": "^0.8.1",
    "@toruslabs/config": "^5.0.0",
    "@toruslabs/oxlint-config-typescript": "^1.1.0",
    "@toruslabs/torus-scripts": "^9.0.1",
    "@types/clone": "^2.1.4",
    "@types/detect-node": "^2.0.2",
    "@types/node": "^26.6.6",
    "@vitest/browser-playwright": "5.1.0",
    "@vitest/coverage-istanbul": "5.1.0",
    "clone": "2.1.2",
    "concurrently": "^9.2.1",
    "detect-node": "^2.1.0",
    "esbuild": "^0.28.1",
    "http-server": "14.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "playwright": "^1.65.0",
    "testcafe": "3.7.7",
    "typescript": "^7.0.2",
    "unload": "^2.4.1",
    "vite-plus": "1.5.0"
  },
  "lint-staged": {
    "!(*d).{js,ts,mjs,mts}": [
      "vp fmt --no-error-on-unmatched-pattern",
      "vp lint --fix --no-error-on-unmatched-pattern"
    ],
    "!(package-lock).{json,md}": [
      "vp fmt --no-error-on-unmatched-pattern"
    ]
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.5.0",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24.22.0",
    "npm": ">=12"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.17.0",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": false,
    "fsevents@2.3.3": false
  }
}
